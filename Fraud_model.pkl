  "cells": [
    {
      "cell_type": "code",
      "source": [
        "#load model\n",
        "with open('Fraud_model.pkl' , 'rb') as f:\n",
        "  model = pickle.load(f)"
      ],
      "metadata": {
        "id": "1A8t01hsVt1k"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# load model\n",
        "\n",
        "df = pd.read_csv('creditcard.csv.zip')"
      ],
      "metadata": {
        "id": "-M9Oz_xIWOz1"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"Simulation Real-time Transactions...\")\n",
        "print(\"=\"*50)"
      ],
      "metadata": {
        "id": "T4iPIRa-WjTw"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# simulate streaming\n",
        "for index, row in df.sample(20).iterrows():\n",
        "  features = row.drop(['Class' , 'Time']).values.reshape(1,-1)\n",
        "\n",
        "\n",
        "  prediction = model.predict(features)[0]\n",
        "  probability = model.predict_proba(features)[0][1]\n",
        "  actual = row['Class']\n",
        "\n",
        "  if prediction == 1:\n",
        "    print(f\"🚨 FRAUD DETECTED! confidence: {probability:.2%} | Actual : {'Fraud' if actual==1 else 'Legit'}\")\n",
        "\n",
        "  else:\n",
        "     print(f\"✅  Legitimate | confidence: {1-probability:.2%} | Actual : {'Fraud' if actual==1 else 'Legit'}\")\n",
        "\n",
        "  time.sleep(1)"
      ],
      "metadata": {
        "id": "WJzUk76io6-Q"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Mix fraud + legit\n",
        "fraud_df = df[df['Class'] == 1].sample(5)\n",
        "legit_df = df[df['Class'] == 0].sample(15)\n",
        "mixed_df = pd.concat([fraud_df, legit_df]).sample(frac=1)\n",
        "\n",
        "# Run simulation\n",
        "print(\"Listening for transactions...\")\n",
        "print(\"=\"*50)\n",
        "\n",
        "for index, row in mixed_df.iterrows():\n",
        "    transaction = row.to_dict()\n",
        "    simulate_consumer(transaction)\n",
        "    time.sleep(1)"
      ],
      "metadata": {
        "id": "aK6OuGpbwnKl"
      },
      "execution_count": null,
      "outputs": []
    },
